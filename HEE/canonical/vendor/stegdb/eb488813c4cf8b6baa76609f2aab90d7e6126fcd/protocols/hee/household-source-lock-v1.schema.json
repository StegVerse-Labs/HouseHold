{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/hee/household-source-lock-v1.schema.json",
  "title": "HouseHold Canonical Source Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lock_id", "source_repository", "source_commit_sha", "consumer_repository", "protocols", "imported_at", "validation_state", "overlay_only", "incident_data_modified"],
  "properties": {
    "schema_version": {"const": "household-source-lock-v1"},
    "lock_id": {"type": "string", "minLength": 1},
    "source_repository": {"const": "StegVerse-Labs/StegDB"},
    "source_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "consumer_repository": {"const": "StegVerse-Labs/HouseHold"},
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "schema_or_protocol_version"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "schema_or_protocol_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "imported_at": {"type": "string", "format": "date-time"},
    "validation_state": {"type": "string", "enum": ["COMPLETE", "BLOCKED", "RETRY", "REVIEW_REQUIRED", "FAILED"]},
    "validation_receipt_ref": {"type": ["string", "null"]},
    "overlay_only": {"const": true},
    "incident_data_modified": {"const": false},
    "next_executable_task": {"type": ["string", "null"]}
  }
}
