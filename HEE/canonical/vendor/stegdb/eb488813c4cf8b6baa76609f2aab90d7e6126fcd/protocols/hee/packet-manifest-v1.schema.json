{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/hee/packet-manifest-v1.schema.json",
  "title": "HEE Packet Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "incident_id", "escalation_level", "target", "objectives", "artifact_refs", "review_state", "delivery_authorized", "unresolved_uncertainty", "generated_at"],
  "properties": {
    "schema_version": {"const": "hee-packet-manifest-v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "escalation_level": {"type": "integer", "minimum": 1},
    "target": {"type": "string", "minLength": 1},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "excluded_artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "review_state": {"type": "string", "enum": ["DRAFT", "REVIEW_REQUIRED", "REVIEWED", "REJECTED", "SENT"]},
    "delivery_authorized": {"const": false},
    "unresolved_uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_lock_ref": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
